# Copy to deploy/.env (gitignored). deploy/gcp/up.sh reads it so no cloud detail lives in the repo.
PROJECT=my-gcp-project-id          # gcloud project id
DOMAIN=analytics.example.com       # DNS A record -> the VM's IP; Caddy gets the certificate (empty = plain http on the IP)
EMAIL=you@example.com              # for Let's Encrypt notices
ZONE=us-central1-a                 # Always Free e2-micro regions: us-central1, us-east1, us-west1
NAME=hanu-1                        # VM name
BUCKET=                            # default: <PROJECT>-hanu
# TUNNEL=                          # Cloudflare Tunnel token: no public IP at all (see docs/DEPLOY.md)
